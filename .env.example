# ---------- Django ----------
SECRET_KEY=replace-with-50-random-chars-on-production
DEBUG=False
ALLOWED_HOSTS=your-api.onrender.com,api.yourdomain.com

# ---------- Database (Neon Postgres) ----------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ---------- JWT ----------
JWT_ACCESS_LIFETIME_MIN=60
JWT_REFRESH_LIFETIME_DAYS=30

# ---------- CORS ----------
# Comma-separated list of origins allowed to call the API.
# Must include your deployed frontend URL.
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://yourdomain.com

# ---------- Static / Media ----------
MEDIA_URL=/media/
STATIC_URL=/static/

# ---------- OTP ----------
OTP_PROVIDER=console

# ---------- Cloudinary (file/photo uploads) ----------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
