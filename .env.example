# ---------- Django ----------
SECRET_KEY=replace-with-50-random-chars-on-production
DEBUG=False
ALLOWED_HOSTS=your-api.onrender.com,api.yourdomain.com

# ---------- Database (Neon Postgres) ----------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ---------- JWT ----------
JWT_ACCESS_LIFETIME_MIN=60
JWT_REFRESH_LIFETIME_DAYS=30

# ---------- CORS ----------
# Comma-separated list of origins allowed to call the API.
# Must include your deployed frontend URL.
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://yourdomain.com

# ---------- Static / Media ----------
MEDIA_URL=/media/
STATIC_URL=/static/

# ---------- OTP ----------
OTP_PROVIDER=console

# ---------- Cloudinary (file/photo uploads) ----------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---------- Razorpay (subscription payments) ----------
# Get test keys from https://dashboard.razorpay.com/app/website-app-settings/api-keys
# In production replace `rzp_test_` with `rzp_live_`.
RAZORPAY_KEY_ID=rzp_test_SwjXecIeqIrQu3
RAZORPAY_KEY_SECRET=DxJC1tLEGpdPoCELkMi7mcEm
# Webhook secret used to verify payment-success callbacks from Razorpay.
# Configure under Dashboard → Settings → Webhooks (same value goes here).
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ---------- Subscriptions ----------
# Set to True only in DEBUG/staging. In production this MUST be False so
# the demo upgrade button does not give away paid plans for free.
SUBSCRIPTION_ALLOW_DEMO_ACTIVATION=False

# ---------- AI Assistant ----------
# Create a key from https://aistudio.google.com/app/apikey and set it only in
# your real .env / hosting environment. Never commit the real key.
# Key must start with AIza... (Google AI Studio), not a GCP service key (AQ...).
GEMINI_API_KEY=your-gemini-api-key
# Optional — defaults to gemini-2.5-flash with fallbacks if this model changes.
GEMINI_MODEL=gemini-2.5-flash
